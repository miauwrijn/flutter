// Writes each texel's own coordinates into a storage texture, so the bytes
// read back at (x, y) are (x, y, 0, 255).

layout(local_size_x = 4, local_size_y = 4) in;

layout(binding = 0, rgba8) uniform writeonly image2D output_image;

void main() {
  ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = imageSize(output_image);
  if (coord.x >= size.x || coord.y >= size.y) {
    return;
  }
  imageStore(output_image, coord,
             vec4(float(coord.x) / 255.0, float(coord.y) / 255.0, 0.0, 1.0));
}
